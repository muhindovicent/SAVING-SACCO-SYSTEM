{
  "name": "saving-sacco-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:server": "cd backend && npm run start:dev",
    "dev:client": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "seed": "cd backend && npx ts-node prisma/seed.ts",
    "build": "cd frontend && npm run build",
    "start:server": "cd backend && npm run start:prod",
    "start:client": "cd frontend && npm run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
