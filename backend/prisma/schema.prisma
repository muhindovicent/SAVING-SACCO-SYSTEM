// ─────────────────────────────────────────────────────────
// Jenga Wealth – Enterprise Prisma Schema
// PostgreSQL 17 – ACID compliant, Row-Level Security ready
// ─────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ═════════════════════════════════════════════════════════
// IDENTITY & ACCESS MANAGEMENT
// ═════════════════════════════════════════════════════════

enum Role {
  ADMINISTRATOR
  TREASURER
  LOAN_OFFICER
  AUDITOR
  BOARD_MEMBER
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  username        String     @unique @db.VarChar(50)
  email           String     @unique @db.VarChar(255)
  phone           String?    @db.VarChar(20)
  passwordHash    String     @map("password_hash") @db.Text
  passwordSalt    String?    @map("password_salt") @db.VarChar(64)
  role            Role       @default(MEMBER)
  status          UserStatus @default(PENDING_VERIFICATION)
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  mfaSecret       String?    @map("mfa_secret") @db.Text
  mfaMethod       String?    @map("mfa_method") @db.VarChar(20) // sms, email, authenticator
  lastLoginAt     DateTime?  @map("last_login_at")
  lastLoginIp     String?    @map("last_login_ip") @db.VarChar(45)
  loginAttempts   Int        @default(0) @map("login_attempts")
  lockedUntil     DateTime?  @map("locked_until")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")
  isDeleted       Boolean    @default(false) @map("is_deleted")
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  member          Member?
  sessions        UserSession[]
  devices         UserDevice[]
  loginHistory    LoginAttempt[]
  passwordHistory PasswordHistory[]
  auditLogs       AuditLog[]       @relation("AuditUser")
  systemEvents    SystemEvent[]    @relation("SystemActor")

  @@map("users")
}

model UserSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  token       String   @unique @db.Text
  refreshToken String? @unique @map("refresh_token") @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  deviceId    String?  @map("device_id") @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  expiresAt   DateTime @map("expires_at")
  lastActivityAt DateTime? @map("last_activity_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
  @@map("user_sessions")
}

model UserDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  deviceId    String   @map("device_id") @db.VarChar(255)
  deviceName  String?  @map("device_name") @db.VarChar(255)
  deviceType  String?  @map("device_type") @db.VarChar(50)
  isTrusted   Boolean  @default(false) @map("is_trusted")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  username  String   @db.VarChar(50)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  success   Boolean
  failReason String? @map("fail_reason") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("login_attempts")
}

model PasswordHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  passwordHash String @map("password_hash") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_history")
}

// ═════════════════════════════════════════════════════════
// MEMBER MANAGEMENT
// ═════════════════════════════════════════════════════════

enum MemberStatus {
  ACTIVE
  INACTIVE
  DORMANT
  SUSPENDED
  RESIGNED
  DECEASED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

model Member {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  memberNumber  String       @unique @map("member_number") @db.VarChar(20)
  status        MemberStatus @default(ACTIVE)
  dateJoined    DateTime     @default(now()) @map("date_joined")
  statusChangedAt DateTime?  @map("status_changed_at")

  // Personal
  fullName      String       @map("full_name") @db.VarChar(255)
  dateOfBirth   DateTime?    @map("date_of_birth")
  gender        String?      @db.VarChar(10)
  nationality   String?      @db.VarChar(100)

  // Contact
  email         String?      @db.VarChar(255)
  phonePrimary  String?      @map("phone_primary") @db.VarChar(20)
  phoneSecondary String?     @map("phone_secondary") @db.VarChar(20)
  addressLine1  String?      @map("address_line1") @db.VarChar(255)
  addressLine2  String?      @map("address_line2") @db.VarChar(255)
  city          String?      @db.VarChar(100)
  district      String?      @db.VarChar(100)
  country       String?      @default("Uganda") @db.VarChar(100)

  // Employment
  occupation    String?      @db.VarChar(255)
  employer      String?      @db.VarChar(255)
  incomeRange   String?      @map("income_range") @db.VarChar(50)

  // KYC
  kycStatus     KycStatus    @default(NOT_SUBMITTED) @map("kyc_status")
  kycVerifiedAt DateTime?    @map("kyc_verified_at")
  kycVerifiedBy String?      @map("kyc_verified_by") @db.Uuid
  idType        String?      @map("id_type") @db.VarChar(50)
  idNumber      String?      @map("id_number") @db.VarChar(100)
  idExpiryDate  DateTime?    @map("id_expiry_date")

  // Encrypted fields (AES-256 at application layer)
  idNumberEncrypted   String? @map("id_number_encrypted") @db.Text
  phoneEncrypted      String? @map("phone_encrypted") @db.Text

  // Soft delete
  isDeleted     Boolean      @default(false) @map("is_deleted")
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id])
  beneficiaries Beneficiary[]
  documents     MemberDocument[]
  savingsAccounts SavingsAccount[]
  loanApplications LoanApplication[]
  loans        Loan[]
  loanRepayments LoanRepayment[]
  shares       Share[]
  sharePurchases SharePurchase[]

  @@index([memberNumber])
  @@index([status])
  @@index([kycStatus])
  @@map("members")
}

model Beneficiary {
  id            String   @id @default(uuid()) @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(255)
  relationship  String   @db.VarChar(50)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(255)
  idNumber      String?  @map("id_number") @db.VarChar(100)
  allocationPct Decimal? @map("allocation_pct") @db.Decimal(5, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@map("beneficiaries")
}

model MemberDocument {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  docType   String   @map("doc_type") @db.VarChar(50)
  fileName  String   @map("file_name") @db.VarChar(255)
  filePath  String   @map("file_path") @db.Text
  fileHash  String   @map("file_hash") @db.VarChar(64)
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type") @db.VarChar(100)
  isVerified Boolean @default(false) @map("is_verified")
  verifiedBy String? @map("verified_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@map("member_documents")
}

// ═════════════════════════════════════════════════════════
// SAVINGS MODULE
// ═════════════════════════════════════════════════════════

enum SavingsAccountStatus {
  ACTIVE
  FROZEN
  DORMANT
  CLOSED
}

enum SavingsProductType {
  REGULAR
  FIXED_DEPOSIT
  GOAL_BASED
  INSTITUTIONAL
}

model SavingsProduct {
  id             String             @id @default(uuid()) @db.Uuid
  name           String             @db.VarChar(255)
  code           String             @unique @db.VarChar(20)
  description    String?            @db.Text
  productType    SavingsProductType @default(REGULAR) @map("product_type")
  minBalance     Decimal            @default(0) @map("min_balance") @db.Decimal(15, 2)
  maxBalance     Decimal?           @map("max_balance") @db.Decimal(15, 2)
  interestRate   Decimal            @default(0) @map("interest_rate") @db.Decimal(5, 2)
  interestFreq   String             @default("MONTHLY") @map("interest_freq") @db.VarChar(20)
  charges        Json?              @default("[]")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  accounts SavingsAccount[]

  @@map("savings_products")
}

model SavingsAccount {
  id              String               @id @default(uuid()) @db.Uuid
  memberId        String               @map("member_id") @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  accountNumber   String               @unique @map("account_number") @db.VarChar(20)
  status          SavingsAccountStatus @default(ACTIVE)
  balance         Decimal              @default(0) @db.Decimal(15, 2)
  availableBalance Decimal             @default(0) @map("available_balance") @db.Decimal(15, 2)
  lienAmount      Decimal              @default(0) @map("lien_amount") @db.Decimal(15, 2)
  lastInterestAt  DateTime?            @map("last_interest_at")
  lastTransactionAt DateTime?          @map("last_transaction_at")
  isDeleted       Boolean              @default(false) @map("is_deleted")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  member   Member         @relation(fields: [memberId], references: [id])
  product  SavingsProduct @relation(fields: [productId], references: [id])
  goals    SavingsGoal[]
  interest SavingsInterest[]
  transactions SavingsTransaction[]

  @@index([memberId])
  @@index([productId])
  @@map("savings_accounts")
}

model SavingsGoal {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  name        String   @db.VarChar(255)
  targetAmount Decimal @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal @default(0) @map("current_amount") @db.Decimal(15, 2)
  targetDate  DateTime? @map("target_date")
  autoAllocate Decimal? @map("auto_allocate") @db.Decimal(15, 2)
  achievedAt  DateTime? @map("achieved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account SavingsAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("savings_goals")
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
  TRANSFER_IN
  TRANSFER_OUT
  FEE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  CARD
  INTERNAL
}

model SavingsTransaction {
  id            String                  @id @default(uuid()) @db.Uuid
  accountId     String                  @map("account_id") @db.Uuid
  type          SavingsTransactionType
  amount        Decimal                 @db.Decimal(15, 2)
  balanceBefore Decimal                 @map("balance_before") @db.Decimal(15, 2)
  balanceAfter  Decimal                 @map("balance_after") @db.Decimal(15, 2)
  reference     String?                 @db.VarChar(100)
  description   String?                 @db.Text
  paymentMethod PaymentMethod?          @map("payment_method")
  receiptNumber String?                 @map("receipt_number") @db.VarChar(50)
  journalId     String?                 @map("journal_id") @db.Uuid
  createdAt     DateTime                @default(now()) @map("created_at")

  account SavingsAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
  @@map("savings_transactions")
}

model SavingsInterest {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  amount      Decimal  @db.Decimal(15, 2)
  rate        Decimal  @db.Decimal(5, 2)
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  journalId   String?  @map("journal_id") @db.Uuid
  creditedAt  DateTime @default(now()) @map("credited_at")

  account SavingsAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("savings_interest")
}

// ═════════════════════════════════════════════════════════
// LOANS MODULE
// ═════════════════════════════════════════════════════════

enum LoanStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE
  OVERDUE
  RESTRUCTURED
  PAID
  WRITTEN_OFF
  REJECTED
}

enum LoanProductType {
  REGULAR
  EMERGENCY
  AGRICULTURE
  EDUCATION
  BUSINESS
  GROUP
}

model LoanProduct {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(255)
  code            String         @unique @db.VarChar(20)
  description     String?        @db.Text
  productType     LoanProductType @default(REGULAR) @map("product_type")
  minAmount       Decimal        @map("min_amount") @db.Decimal(15, 2)
  maxAmount       Decimal?       @map("max_amount") @db.Decimal(15, 2)
  interestRate    Decimal        @map("interest_rate") @db.Decimal(5, 2)
  interestMethod  String         @default("FLAT") @map("interest_method") @db.VarChar(20)
  repaymentPeriod Int            @map("repayment_period") // months
  repaymentFreq   String         @default("MONTHLY") @map("repayment_freq") @db.VarChar(20)
  gracePeriod     Int            @default(0) @map("grace_period") // days
  latePenaltyRate Decimal?       @map("late_penalty_rate") @db.Decimal(5, 2)
  latePenaltyFixed Decimal?      @map("late_penalty_fixed") @db.Decimal(15, 2)
  processingFee   Decimal?       @map("processing_fee") @db.Decimal(5, 2)
  requiresGuarantor Boolean     @default(false) @map("requires_guarantor")
  requiresCollateral Boolean    @default(false) @map("requires_collateral")
  maxGuarantors   Int            @default(2) @map("max_guarantors")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  applications LoanApplication[]

  @@map("loan_products")
}

model LoanApplication {
  id            String           @id @default(uuid()) @db.Uuid
  memberId      String           @map("member_id") @db.Uuid
  productId     String           @map("product_id") @db.Uuid
  applicationNo String           @unique @map("application_no") @db.VarChar(20)
  principal     Decimal          @db.Decimal(15, 2)
  purpose       String?          @db.Text
  repaymentPeriod Int            @map("repayment_period") // months
  status        LoanStatus       @default(PENDING)
  riskScore     Int?             @map("risk_score")
  reviewedBy    String?          @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?        @map("reviewed_at")
  rejectionReason String?        @map("rejection_reason") @db.Text
  submittedAt   DateTime         @default(now()) @map("submitted_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  member    Member        @relation(fields: [memberId], references: [id])
  product   LoanProduct   @relation(fields: [productId], references: [id])
  loan      Loan?
  guarantors LoanGuarantor[]
  collaterals LoanCollateral[]

  @@index([memberId])
  @@index([status])
  @@map("loan_applications")
}

model Loan {
  id              String       @id @default(uuid()) @db.Uuid
  applicationId   String       @unique @map("application_id") @db.Uuid
  memberId        String       @map("member_id") @db.Uuid
  loanNo          String       @unique @map("loan_no") @db.VarChar(20)
  principal       Decimal      @db.Decimal(15, 2)
  interestRate    Decimal      @map("interest_rate") @db.Decimal(5, 2)
  interestMethod  String       @default("FLAT") @map("interest_method") @db.VarChar(20)
  totalInterest   Decimal      @map("total_interest") @db.Decimal(15, 2)
  totalAmount     Decimal      @map("total_amount") @db.Decimal(15, 2)
  amountPaid      Decimal      @default(0) @map("amount_paid") @db.Decimal(15, 2)
  balance         Decimal      @map("balance") @db.Decimal(15, 2)
  repaymentPeriod Int          @map("repayment_period") // months
  repaymentFreq   String       @default("MONTHLY") @map("repayment_freq") @db.VarChar(20)
  disbursedAt     DateTime?    @map("disbursed_at")
  disbursedBy     String?      @map("disbursed_by") @db.Uuid
  firstDueDate    DateTime?    @map("first_due_date")
  lastDueDate     DateTime?    @map("last_due_date")
  status          LoanStatus   @default(ACTIVE)
  restructuredAt  DateTime?    @map("restructured_at")
  paidAt          DateTime?    @map("paid_at")
  writtenOffAt    DateTime?    @map("written_off_at")
  writtenOffBy    String?      @map("written_off_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  application  LoanApplication @relation(fields: [applicationId], references: [id])
  member       Member          @relation(fields: [memberId], references: [id])
  schedules    LoanSchedule[]
  repayments   LoanRepayment[]
  penalties    LoanPenalty[]

  @@index([memberId])
  @@index([status])
  @@map("loans")
}

model LoanSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  loanId      String    @map("loan_id") @db.Uuid
  installment Int       @map("installment")
  dueDate     DateTime  @map("due_date")
  principal   Decimal   @db.Decimal(15, 2)
  interest    Decimal   @db.Decimal(15, 2)
  fees        Decimal   @default(0) @db.Decimal(15, 2)
  totalAmount Decimal   @map("total_amount") @db.Decimal(15, 2)
  paidAmount  Decimal   @default(0) @map("paid_amount") @db.Decimal(15, 2)
  balance     Decimal   @map("balance") @db.Decimal(15, 2)
  status      String    @default("PENDING") @db.VarChar(20) // PENDING, PARTIAL, PAID, OVERDUE
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  loan Loan @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@map("loan_schedules")
}

model LoanRepayment {
  id        String   @id @default(uuid()) @db.Uuid
  loanId    String   @map("loan_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  amount    Decimal  @db.Decimal(15, 2)
  principalPortion Decimal @map("principal_portion") @db.Decimal(15, 2)
  interestPortion  Decimal @map("interest_portion") @db.Decimal(15, 2)
  penaltyPortion   Decimal @default(0) @map("penalty_portion") @db.Decimal(15, 2)
  paymentMethod String @map("payment_method") @db.VarChar(50)
  reference  String?  @db.VarChar(100)
  journalId  String?  @map("journal_id") @db.Uuid
  receivedBy String   @map("received_by") @db.Uuid
  notes      String?  @db.Text
  paidAt     DateTime @default(now()) @map("paid_at")
  createdAt  DateTime @default(now()) @map("created_at")

  loan   Loan @relation(fields: [loanId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([loanId])
  @@index([memberId])
  @@map("loan_repayments")
}

model LoanPenalty {
  id          String   @id @default(uuid()) @db.Uuid
  loanId      String   @map("loan_id") @db.Uuid
  amount      Decimal  @db.Decimal(15, 2)
  reason      String   @db.VarChar(255)
  daysOverdue Int      @map("days_overdue")
  waivedAt    DateTime? @map("waived_at")
  waivedBy    String?  @map("waived_by") @db.Uuid
  journalId   String?  @map("journal_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  loan Loan @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@map("loan_penalties")
}

model LoanGuarantor {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  guarantorId   String   @map("guarantor_id") @db.Uuid // member ID
  amount        Decimal  @db.Decimal(15, 2)
  approved      Boolean  @default(false)
  approvedAt    DateTime? @map("approved_at")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  application LoanApplication @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, guarantorId])
  @@map("loan_guarantors")
}

model LoanCollateral {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  type          String   @db.VarChar(100)
  description   String?  @db.Text
  estimatedValue Decimal @map("estimated_value") @db.Decimal(15, 2)
  documentRef   String?  @map("document_ref") @db.VarChar(255)
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  application LoanApplication @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@map("loan_collaterals")
}

// ═════════════════════════════════════════════════════════
// SHARES / CAPITAL MODULE
// ═════════════════════════════════════════════════════════

model Share {
  id            String   @id @default(uuid()) @db.Uuid
  memberId      String   @unique @map("member_id") @db.Uuid
  totalUnits    Decimal  @default(0) @map("total_units") @db.Decimal(15, 2)
  totalValue    Decimal  @default(0) @map("total_value") @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  member  Member          @relation(fields: [memberId], references: [id])
  purchases SharePurchase[]

  @@index([memberId])
  @@map("shares")
}

model SharePurchase {
  id            String   @id @default(uuid()) @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  shareId       String   @map("share_id") @db.Uuid
  units         Decimal  @db.Decimal(15, 2)
  pricePerUnit  Decimal  @map("price_per_unit") @db.Decimal(15, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(15, 2)
  journalId     String?  @map("journal_id") @db.Uuid
  purchasedAt   DateTime @default(now()) @map("purchased_at")

  member Member @relation(fields: [memberId], references: [id])
  share  Share  @relation(fields: [shareId], references: [id])

  @@index([memberId])
  @@map("share_purchases")
}

model ShareValue {
  id        String   @id @default(uuid()) @db.Uuid
  pricePerUnit Decimal @map("price_per_unit") @db.Decimal(15, 2)
  effectiveDate DateTime @map("effective_date") @db.Date
  setBy     String   @map("set_by") @db.Uuid
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([effectiveDate])
  @@map("share_values")
}

model DividendDistribution {
  id            String   @id @default(uuid()) @db.Uuid
  financialYear String   @map("financial_year") @db.VarChar(10)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(15, 2)
  perUnitAmount Decimal  @map("per_unit_amount") @db.Decimal(15, 2)
  declaredAt    DateTime @map("declared_at")
  paidAt        DateTime? @map("paid_at")
  approvedBy    String   @map("approved_by") @db.Uuid
  status        String   @default("DECLARED") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("dividend_distributions")
}

// ═════════════════════════════════════════════════════════
// TREASURY / CASH MANAGEMENT
// ═════════════════════════════════════════════════════════

enum CashAccountType {
  PETTY_CASH
  BANK
  MOBILE_MONEY
  CASH_IN_TRANSIT
  INVESTMENT
}

model CashAccount {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(255)
  accountType    CashAccountType @map("account_type")
  accountNumber  String?        @map("account_number") @db.VarChar(50)
  bankName       String?        @map("bank_name") @db.VarChar(255)
  branchCode     String?        @map("branch_code") @db.VarChar(50)
  swiftCode      String?        @map("swift_code") @db.VarChar(20)
  mobileProvider String?        @map("mobile_provider") @db.VarChar(50)
  mobileNumber   String?        @map("mobile_number") @db.VarChar(20)
  balance        Decimal        @default(0) @db.Decimal(15, 2)
  currency       String         @default("UGX") @db.VarChar(3)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  reconciliations CashReconciliation[]

  @@map("cash_accounts")
}

model CashReconciliation {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  systemBalance Decimal @map("system_balance") @db.Decimal(15, 2)
  actualBalance Decimal @map("actual_balance") @db.Decimal(15, 2)
  difference  Decimal  @db.Decimal(15, 2)
  reconciledAt DateTime @map("reconciled_at")
  reconciledBy String   @map("reconciled_by") @db.Uuid
  notes       String?  @db.Text
  status      String   @default("PENDING") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  account CashAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("cash_reconciliations")
}

// ═════════════════════════════════════════════════════════
// DOUBLE-ENTRY ACCOUNTING ENGINE
// ═════════════════════════════════════════════════════════

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountSubCategory {
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  SHARE_CAPITAL
  RETAINED_EARNINGS
  RESERVES
  INTEREST_INCOME
  FEE_INCOME
  OPERATING_EXPENSE
  ADMIN_EXPENSE
  PROVISION_EXPENSE
}

model ChartOfAccount {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(20)
  name        String            @db.VarChar(255)
  description String?           @db.Text
  category    AccountCategory
  subCategory AccountSubCategory? @map("sub_category")
  isActive    Boolean           @default(true) @map("is_active")
  isControl   Boolean           @default(false) @map("is_control") // control account
  parentId    String?           @map("parent_id") @db.Uuid
  normalSide  String            @map("normal_side") @db.VarChar(5) // DEBIT or CREDIT
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  parent  ChartOfAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("AccountHierarchy")
  journalLines JournalLine[]
  generalLedgers GeneralLedger[]

  @@index([code])
  @@index([category])
  @@map("chart_of_accounts")
}

model FinancialPeriod {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isClosed  Boolean  @default(false) @map("is_closed")
  closedAt  DateTime? @map("closed_at")
  closedBy  String?  @map("closed_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  journals JournalEntry[]
  generalLedgers GeneralLedger[]

  @@map("financial_periods")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  journalNo   String   @unique @map("journal_no") @db.VarChar(20)
  description String?  @db.Text
  periodId    String   @map("period_id") @db.Uuid
  entryDate   DateTime @map("entry_date")
  totalDebit  Decimal  @map("total_debit") @db.Decimal(15, 2)
  totalCredit Decimal  @map("total_credit") @db.Decimal(15, 2)
  reference   String?  @db.VarChar(100)
  referenceId String?  @map("reference_id") @db.Uuid // links to source transaction
  refType     String?  @map("ref_type") @db.VarChar(50) // loan_disbursement, deposit, etc.
  isReversal  Boolean  @default(false) @map("is_reversal")
  reversedById String? @unique @map("reversed_by_id") @db.Uuid
  postedBy    String   @map("posted_by") @db.Uuid
  postedAt    DateTime @default(now()) @map("posted_at")
  isPosted    Boolean  @default(true) @map("is_posted")
  createdAt   DateTime @default(now()) @map("created_at")

  period FinancialPeriod @relation(fields: [periodId], references: [id])
  lines  JournalLine[]
  reversal JournalEntry? @relation("Reversal", fields: [reversedById], references: [id])
  reversedBy JournalEntry? @relation("Reversal")

  @@index([periodId])
  @@index([entryDate])
  @@index([referenceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String   @id @default(uuid()) @db.Uuid
  journalId   String   @map("journal_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  debit       Decimal  @default(0) @db.Decimal(15, 2)
  credit      Decimal  @default(0) @db.Decimal(15, 2)
  description String?  @db.Text

  journal JournalEntry    @relation(fields: [journalId], references: [id])
  account ChartOfAccount  @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

model GeneralLedger {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  periodId  String   @map("period_id") @db.Uuid
  opening   Decimal  @default(0) @db.Decimal(15, 2)
  debits    Decimal  @default(0) @db.Decimal(15, 2)
  credits   Decimal  @default(0) @db.Decimal(15, 2)
  closing   Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  account ChartOfAccount  @relation(fields: [accountId], references: [id])
  period  FinancialPeriod @relation(fields: [periodId], references: [id])

  @@unique([accountId, periodId])
  @@map("general_ledger")
}

// ═════════════════════════════════════════════════════════
// AUDIT & OBSERVABILITY
// ═════════════════════════════════════════════════════════

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  DISBURSE
  EXPORT
  PRINT
}

enum AuditEntity {
  USER
  MEMBER
  SAVINGS_ACCOUNT
  LOAN
  LOAN_APPLICATION
  LOAN_REPAYMENT
  SHARE
  JOURNAL_ENTRY
  CASH_ACCOUNT
  RECONCILIATION
  ANNOUNCEMENT
  SYSTEM_CONFIG
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  action      AuditAction
  entity      AuditEntity
  entityId    String?     @map("entity_id") @db.Uuid
  description String?     @db.Text
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.Text
  sessionId   String?     @map("session_id") @db.Uuid
  correlationId String?   @map("correlation_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")

  user  User? @relation("AuditUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(100)
  severity    String   @default("INFO") @db.VarChar(20) // INFO, WARNING, ERROR, CRITICAL
  message     String?  @db.Text
  metadata    Json?
  source      String?  @db.VarChar(100)
  traceId     String?  @map("trace_id") @db.VarChar(100)
  actorId     String?  @map("actor_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("SystemActor", fields: [actorId], references: [id])

  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@map("system_events")
}

// ═════════════════════════════════════════════════════════
// GOVERNANCE
// ═════════════════════════════════════════════════════════

enum MeetingType {
  AGM
  BOARD
  COMMITTEE
  SPECIAL
}

model Meeting {
  id          String      @id @default(uuid()) @db.Uuid
  title       String      @db.VarChar(255)
  type        MeetingType @default(AGM)
  date        DateTime
  venue       String?     @db.VarChar(255)
  agenda      Json?       @default("[]")
  minutes     String?     @db.Text
  status      String      @default("SCHEDULED") @db.VarChar(20)
  createdBy   String      @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  resolutions Resolution[]

  @@map("meetings")
}

model Resolution {
  id          String   @id @default(uuid()) @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("PROPOSED") @db.VarChar(20) // PROPOSED, PASSED, REJECTED, IMPLEMENTED
  votesFor    Int      @default(0) @map("votes_for")
  votesAgainst Int     @default(0) @map("votes_against")
  votesAbstain Int     @default(0) @map("votes_abstain")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
  @@map("resolutions")
}

model Vote {
  id          String   @id @default(uuid()) @db.Uuid
  resolutionId String @map("resolution_id") @db.Uuid
  memberId    String   @map("member_id") @db.Uuid
  vote        String   @db.VarChar(10) // FOR, AGAINST, ABSTAIN
  castAt      DateTime @default(now()) @map("cast_at")

  @@unique([resolutionId, memberId])
  @@map("votes")
}

// ═════════════════════════════════════════════════════════
// SYSTEM CONFIGURATION
// ═════════════════════════════════════════════════════════

model SystemConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     Json
  type      String   @default("STRING") @db.VarChar(20)
  group     String?  @db.VarChar(50)
  isEncrypted Boolean @default(false) @map("is_encrypted")
  description String? @db.Text
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
